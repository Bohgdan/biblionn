generator client {
  provider = "prisma-client-js"

  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model Book {
  id              String   @id @default(cuid())
  title           String
  authors         String
  price           Int
  condition       String   @default("Добрий")
  language        String   @default("Українська")
  isbn            String?
  description     String?
  contactEmail    String?
  contactPhone    String?
  images          String
  sellerEmail     String
  sellerInstagram String
  validationLink  String   @unique @default(cuid())
  isValidated     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
